{
  "name": "CameraSplineDefinition",
  "kind": "struct",
  "fields": [
    {
      "name": "name",
      "order": 0,
      "type": "string",
      "optional": false,
      "constraints": {
        "pattern": "^\\w+:\\w+$"
      }
    },
    {
      "name": "total_time",
      "order": 1,
      "type": "float",
      "optional": false,
      "constraints": {
        "minimum": 0.0
      }
    },
    {
      "name": "spline_type",
      "order": 2,
      "type": "string",
      "optional": true,
      "default": "catmullrom",
      "constraints": {
        "pattern": "^(?:catmullrom|linear)$"
      }
    },
    {
      "name": "control_points",
      "order": 3,
      "type": "CameraSplineControlPoint[]",
      "optional": false
    },
    {
      "name": "progress_key_frames",
      "order": 4,
      "type": "CameraSplineProgressKeyFrame[]",
      "optional": false
    },
    {
      "name": "rotation_key_frames",
      "order": 5,
      "type": "CameraSplineRotationKeyFrame[]",
      "optional": false
    }
  ]
}
