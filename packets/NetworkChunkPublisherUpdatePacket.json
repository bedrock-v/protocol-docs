{
  "name": "NetworkChunkPublisherUpdatePacket",
  "kind": "packet",
  "id": 121,
  "description": "Used (from the server) when a user's Chunk View moves, I.e. the area that determines what chunks exist. For ClientSideGeneration we also send the client a list of ChunkPos that the Server will fully build.",
  "protocolVersion": 2168,
  "minecraftVersion": "1.26.40",
  "fields": [
    {
      "name": "New position for view",
      "order": 0,
      "type": "BlockPos",
      "optional": false
    },
    {
      "name": "New radius for view",
      "order": 1,
      "type": "uint32",
      "optional": false,
      "serialization": [
        "Compression"
      ]
    },
    {
      "name": "Server Built Chunks List",
      "order": 2,
      "type": "ChunkPos[]",
      "optional": false,
      "serialization": [
        "No size compression"
      ]
    }
  ]
}
