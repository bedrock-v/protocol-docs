      "type": "string",
      "optional": false
    },
    {
      "name": "Photo Data",
      "order": 1,
      "type": "string",
      "optional": false
    },
    {
      "name": "Book ID",
      "order": 2,
      "type": "string",
      "optional": false
    },
    {
      "name": "Type",
      "order": 3,
      "type": "PhotoType",
      "optional": false,
      "underlyingType": "uint8",
      "serialization": [
        "Enum-as-Value"
      ]
    },
    {
      "name": "Source Type",
      "order": 4,
      "type": "PhotoType",
      "optional": false,
      "underlyingType": "uint8",
      "serialization": [
        "Enum-as-Value"
      ]
    },
    {
      "name": "Owner ID",
      "order": 5,
      "type": "int64",
