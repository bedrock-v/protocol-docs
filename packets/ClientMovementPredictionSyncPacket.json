      "type": "ActorDataBoundingBoxComponent",
      "optional": false
    },
    {
      "name": "Movement Attributes",
      "order": 2,
      "type": "MovementAttributesComponent",
      "optional": false
    },
    {
      "name": "Actor Unique ID",
      "order": 3,
      "type": "ActorUniqueID",
      "optional": false
    },
    {
