      "type": "ActorRuntimeID",
      "optional": false
    },
    {
      "name": "Emote Id",
      "order": 1,
      "type": "string",
      "optional": false
    },
    {
      "name": "Emote Length Ticks",
      "order": 2,
      "type": "uint32",
      "optional": false,
      "serialization": [
        "Compression"
      ]
    },
    {
      "name": "Xuid",
      "order": 3,
      "type": "string",
      "optional": false
    },
    {
      "name": "PlatformId",
      "order": 4,
      "type": "string",
      "optional": false
    },
    {
      "name": "Flags",
      "order": 5,
      "type": "uint8",
      "optional": false
    }
  ]
}
