{
  "name": "UpdateBlockSyncedPacket",
  "kind": "packet",
  "id": 110,
  "description": "Variation of UpdateBlockSyncedPacket that includes information to sync entities with renderchunk generation. Occasionally when blocks change a sync message is sent and during the change on the dimension, this packet is sent to the client to alert the update flags and sync info at a specific position.",
  "fields": [
    {
      "name": "Block Position",
      "order": 0,
      "type": "BlockPos",
      "optional": false
    },
    {
      "name": "Block Runtime ID",
      "order": 1,
      "type": "uint32",
      "optional": false,
      "serialization": [
        "Compression"
      ]
    },
    {
      "name": "Flags",
      "order": 2,
      "type": "uint32",
      "optional": false,
      "serialization": [
        "Compression"
      ]
    },
    {
      "name": "Layer",
      "order": 3,
      "type": "uint32",
      "optional": false,
      "serialization": [
        "Compression"
      ]
    },
    {
      "name": "Unique Actor Id",
      "order": 4,
      "type": "uint64",
      "optional": false,
      "serialization": [
        "Compression"
      ]
    },
    {
      "name": "Actor Sync Message",
      "order": 5,
      "type": "uint64",
      "optional": false,
      "serialization": [
        "Compression"
      ]
    }
  ]
}
