{
  "name": "NpcRequestPacket",
  "kind": "packet",
  "id": 98,
  "description": "A request is made from the client during an interaction with an NPC then the request is processed by the server. \n\tActor MUST have the NPCComponent to be handled. \n\tWe currently only use this for EDU, but the goal was to expose the NPC Component to creators.",
  "fields": [
    {
      "name": "NPC Runtime ID",
      "order": 0,
      "type": "ActorRuntimeID",
      "optional": false
    },
    {
      "name": "Request Type",
      "order": 1,
      "type": "NpcRequestPacketPayload_RequestType",
      "optional": false,
      "underlyingType": "uint8",
      "serialization": [
        "Enum-as-Value"
      ]
    },
    {
      "name": "Actions",
      "order": 2,
      "type": "string",
      "optional": false
    },
    {
      "name": "Action Index",
      "order": 3,
      "type": "uint8",
      "optional": false
    },
    {
      "name": "Scene Name",
      "order": 4,
      "type": "string",
      "optional": false
    }
  ]
}
